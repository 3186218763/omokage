__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 配置（含 API key）
configs/config.yaml

# 模型权重（SBV2 safetensors 在 Style-Bert-VITS2/model_assets，不入库）
model/*.ckpt
model/*.pth
model/*.safetensors

# Live2D Cubism Core 与模型（许可文件，人本地放置）
resources/live2d/core/
resources/live2d/models/
# 数据本地保留，不推远程（训练/采集产物）
data/

# 前端构建产物
frontend/dist/
frontend/node_modules/

# 运行时日志和生成输出
logs/
outputs/

# 本地归档（训练元数据等，体积较大时可不入库）
archive/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# 归档
*.zip
.worktrees/
